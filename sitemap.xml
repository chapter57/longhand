  <url><loc>{{ "/calendar/" | absolute_url }}</loc></url>
  <url><loc>{{ "/reviews/" | absolute_url }}</loc></url>
  <url><loc>{{ "/write/" | absolute_url }}</loc></url>
  {%- for e in site.almanac %}
